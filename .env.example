# Gmail SMTP Configuration for Contact Form Notifications
# Your Gmail account used to send the notification emails
GMAIL_USER=your_email@gmail.com

# Google App Password (16 characters, generated from Google Account > Security > 2-Step Verification > App Passwords)
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Optional: Custom recipient email address for contact notifications (defaults to GMAIL_USER if omitted)
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# Optional: Server Port (defaults to 5000 in production, or assigned by host via process.env.PORT)
PORT=5000

# Optional: GitHub Personal Access Token for higher rate limits on GitHub API metrics
GITHUB_TOKEN=
